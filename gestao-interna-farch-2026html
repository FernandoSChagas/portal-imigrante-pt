<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Painel de Leads - Portal Imigrante PT</title>
    <link rel="stylesheet" href="css/hub.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        .admin-container { max-width: 1100px; margin: 40px auto; padding: 0 20px; }
        
        .admin-card { 
            background: #161b22; 
            border: 1px solid #21262d; 
            border-radius: 16px; 
            padding: 30px; 
            box-shadow: 0 12px 32px rgba(0, 0, 0, 0.5);
        }

        .admin-header { 
            display: flex; 
            justify-content: space-between; 
            align-items: center; 
            border-bottom: 1px dashed #30363d; 
            padding-bottom: 20px; 
            margin-bottom: 25px; 
            flex-wrap: wrap;
            gap: 15px;
        }
        .admin-header h1 { color: #00e5ff; font-size: 1.6rem; margin: 0; font-weight: 700; }
        
        .stats-badge {
            background: rgba(0, 229, 255, 0.1);
            border: 1px solid #00e5ff;
            color: #00e5ff;
            padding: 8px 16px;
            border-radius: 20px;
            font-weight: bold;
            font-size: 0.9rem;
        }

        /* BOTÃO PREMIUM PARA EXPORTAR */
        .btn-export {
            background: linear-gradient(135deg, #10b981, #059669);
            color: white;
            border: none;
            padding: 12px 24px;
            border-radius: 8px;
            font-weight: bold;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.2s;
            text-decoration: none;
            font-size: 0.95rem;
        }
        .btn-export:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
        }

        /* TABELA PREMIUM ESTILO GITHUB DARK */
        .table-responsive { overflow-x: auto; margin-top: 15px; }
        .leads-table { width: 100%; border-collapse: collapse; text-align: left; font-size: 0.95rem; }
        .leads-table th { background: #0d1117; color: #8b949e; padding: 14px; border-bottom: 2px solid #30363d; font-weight: 600; }
        .leads-table td { padding: 14px; border-bottom: 1px solid #21262d; color: #c9d1d9; }
        .leads-table tr:hover td { background: rgba(255, 255, 255, 0.02); }

        .tag-origem {
            background: rgba(0, 163, 163, 0.15);
            color: #00e5ff;
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 0.8rem;
            font-weight: bold;
        }
        
        .loading-text { text-align: center; color: #8b949e; padding: 40px; font-style: italic; }
    </style>
</head>
<body>

    <nav class="navbar">
        <div class="logo">PORTAL<span class="logo-highlight">IMIGRANTE PT</span></div>
        <div class="nav-links">
            <span style="color: #8b949e; font-size: 0.9rem; font-weight: bold;"><i class="fa-solid fa-lock" style="color: #34d399; margin-right: 5px;"></i> Área Restrita</span>
        </div>
    </nav>

    <main class="admin-container">
        <div class="admin-card">
            <div class="admin-header">
                <div>
                    <h1><i class="fa-solid fa-address-book" style="margin-right: 8px;"></i> Base de Contactos Coletados</h1>
                    <p style="color: #8b949e; margin: 5px 0 0 0; font-size: 0.9rem;">Lista de potenciais compradores interessados no E-book.</p>
                </div>
                <div style="display: flex; align-items: center; gap: 15px;">
                    <span class="stats-badge" id="totalBadge">Total: 0 Leads</span>
                    <button class="btn-export" onclick="descarregarCSV()"><i class="fa-solid fa-file-excel"></i> Baixar Excel / CSV</button>
                </div>
            </div>

            <div class="table-responsive">
                <table class="leads-table">
                    <thead>
                        <tr>
                            <th>Data / Hora</th>
                            <th>Nome</th>
                            <th>E-mail</th>
                            <th>WhatsApp</th>
                            <th>Origem</th>
                        </tr>
                    </thead>
                    <tbody id="leadsDados">
                        <tr>
                            <td colspan="5" class="loading-text">A puxar base de dados do Render...</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <script>
        const API_URL = "https://portal-imigrante-pt.onrender.com/api/leads/exportar";
        let leadsLocais = [];

        async function puxarLeads() {
            const tbody = document.getElementById("leadsDados");
            try {
                const response = await fetch(API_URL);
                const data = await response.json();
                
                if (data.leads && data.leads.length > 0) {
                    leadsLocais = data.leads;
                    document.getElementById("totalBadge").innerText = `Total: ${data.total_leads} Leads`;
                    tbody.innerHTML = "";
                    
                    // Renderiza as linhas de trás para a frente (mais recentes primeiro)
                    data.leads.reverse().forEach(lead => {
                        tbody.innerHTML += `
                            <tr>
                                <td style="color: #8b949e; font-family: monospace;">${lead.data}</td>
                                <td style="font-weight: bold; color: #fff;">${lead.nome}</td>
                                <td><a href="mailto:${lead.email}" style="color: #00e5ff; text-decoration: none;">${lead.email}</a></td>
                                <td style="font-family: monospace;">${lead.whatsapp}</td>
                                <td><span class="tag-origem">${lead.origem}</span></td>
                            </tr>
                        `;
                    });
                } else {
                    tbody.innerHTML = `<tr><td colspan="5" class="loading-text">Nenhum contacto registado até ao momento.</td></tr>`;
                }
            } catch (error) {
                tbody.innerHTML = `<tr><td colspan="5" class="loading-text" style="color: #f87171;">Erro ao comunicar com o servidor do Render. Certifica-te de que a API está online.</td></tr>`;
            }
        }

        // FUNÇÃO DE EXPORTAÇÃO AUTOMÁTICA EM UM CLIQUE
        function descarregarCSV() {
            if (leadsLocais.length === 0) {
                alert("Não existem dados para exportar.");
                return;
            }

            let csvContent = "\uFEFF"; // Garante a acentuação correta no Excel brasileiro
            csvContent += "Data,Nome,Email,WhatsApp,Origem\n";

            leadsLocais.forEach(lead => {
                csvContent += `"${lead.data}","${lead.nome}","${lead.email}","${lead.whatsapp}","${lead.origem}"\n`;
            });

            const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const link = document.createElement("a");
            link.setAttribute("href", url);
            link.setAttribute("download", `leads_portal_imigrante_${new Date().toISOString().slice(0,10)}.csv`);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        // Executa ao abrir
        puxarLeads();
    </script>
</body>
</html>
